# File share server config example

# 被分享的根目录，所有文件操作限制在此目录内
SHARE_DIR=shared

# 管理端监听地址。默认 0.0.0.0 是为了让手机 / 平板 / VR 能从内网登录，
# 请不要把 8800 映射到公网——公网只应该有 PUBLIC_PORT。
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8800
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=9900
PUBLIC_BASE_URL=http://example.com:9900
ALLOW_OVERWRITE=false

# 管理员口令：只在新设备首次登录时输入一次。
# 建议用「好记但足够长」的短语，例如 mason-travel-2026，不必背随机串。
ADMIN_TOKEN=replace-with-a-memorable-passphrase
MAX_DOWNLOADS=100

# ---- 设备令牌（登录一次，之后免密）----
# 令牌有效期（天）。到期后该设备需要重新输一次口令。
DEVICE_TOKEN_TTL_DAYS=365
# 受信设备记录文件。只存令牌的 sha256 哈希，不存明文。
DEVICES_FILE=devices.json

# ---- 分享链接持久化 ----
# 分享链接存在这个文件里，服务重启后依然有效（旧版是纯内存，重启即全部失效）。
# 存的是相对 SHARE_DIR 的路径，换盘 / 换机器也能指向对的文件。
SHARES_FILE=shares.json

# ---- 上传与列表 ----
# 单文件上传上限（MB），0 表示不限制。超过会在写入过程中中止并删除半截文件。
# 私人服务里一个误拖的 80GB 镜像能占满连接半天，4GB 是够用又不至于失控的兜底。
MAX_UPLOAD_MB=4096
# 目录列表每页文件数。文件上千时一次全发会明显卡顿，前端点「加载更多」累加。
# 子目录不分页，始终全量返回。
LIST_PAGE_SIZE=200

# ---- 登录限流 ----
# 连续失败多少次触发锁定、首次锁多久（秒）、渐进上限（秒）。
# 默认 5 次 / 5 分钟，再犯翻倍，最长 1 小时。
# 之所以不用「3 次锁 24 小时」：单人内网服务被自己锁在门外一整天，代价远大于收益。
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
LOGIN_LOCKOUT_MAX_SECONDS=3600

# 只有在反向代理（Nginx / Caddy）后面才设为 true。
# 直接暴露时打开会让攻击者伪造 X-Forwarded-For 绕开锁定。
TRUST_PROXY=false

# Vclip 联动（通过 HTTP API 把分享链接写进剪贴板）
# Vclip 的 serve 默认端口是 4173，接口为 POST /api/clips
VCLIP_API_URL=http://127.0.0.1:4173/api/clips
# 必须与 Vclip 的 .env 里 ACCESS_PASSWORD 保持一致，否则会被 401 拒绝
VCLIP_ACCESS_PASSWORD=your_vclip_access_password
# 可选：请求超时（秒）
VCLIP_TIMEOUT_SECONDS=5
