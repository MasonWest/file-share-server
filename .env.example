# File share server config example

SHARE_DIR=shared
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8800
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=9900
PUBLIC_BASE_URL=http://example.com:9900
ALLOW_OVERWRITE=false
ADMIN_TOKEN=replace-with-a-long-random-secret
MAX_DOWNLOADS=100
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_CLIPS_TABLE=clips
