# File share server config example

SHARE_DIR=shared
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8800
PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=9900
PUBLIC_BASE_URL=http://example.com:9900
ALLOW_OVERWRITE=false
ADMIN_TOKEN=replace-with-a-long-random-secret
MAX_DOWNLOADS=100
# Vclip 联动（通过 HTTP API 把分享链接写进剪贴板）
# Vclip 的 serve 默认端口是 4173，接口为 POST /api/clips
VCLIP_API_URL=http://127.0.0.1:4173/api/clips
# 必须与 Vclip 的 .env 里 ACCESS_PASSWORD 保持一致，否则会被 401 拒绝
VCLIP_ACCESS_PASSWORD=your_vclip_access_password
# 可选：请求超时（秒）
VCLIP_TIMEOUT_SECONDS=5
